{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-buffer:contracts:v1",
  "description": "Select a contract with #/$defs/suite, manifest, imports, attempts, grading or findings. Domain constraints are enforced by the CLI.",
  "$defs": {
    "assertion": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "critical": {"type": "boolean"}}},
    "case": {
      "type": "object", "required": ["id", "type", "prompt", "assertions"],
      "properties": {"id": {"type": "string", "pattern": "^[\\w-]+$"}, "type": {"enum": ["routing", "procedure"]}, "prompt": {"type": "string", "minLength": 1}, "fixture": {}, "partition": {"enum": ["development", "acceptance"]}, "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}, "acceptable_primary": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "skill": {"type": "string"}, "resources": {"type": "array", "items": {"type": "string"}}},
      "allOf": [{"if": {"properties": {"type": {"const": "routing"}}}, "then": {"required": ["acceptable_primary"]}, "else": {"required": ["skill"], "properties": {"assertions": {"minItems": 1}}}}]
    },
    "suite": {"type": "object", "required": ["version", "cases"], "properties": {"version": {"const": 1}, "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}}},
    "settings": {"type": "object", "required": ["temperature", "seed", "max_tokens", "repeats", "timeout", "provider_parameters"], "additionalProperties": false, "properties": {"temperature": {"type": "number", "minimum": 0}, "seed": {"type": "integer"}, "max_tokens": {"type": "integer", "minimum": 1}, "repeats": {"type": "integer", "minimum": 1}, "timeout": {"type": "number", "exclusiveMinimum": 0}, "provider_parameters": {"type": "object"}}},
    "job": {"type": "object", "required": ["id", "case_id", "repeat", "variant", "prompt"], "properties": {"id": {"type": "string"}, "case_id": {"type": "string"}, "repeat": {"type": "integer", "minimum": 0}, "variant": {"enum": ["baseline", "candidate"]}, "prompt": {"type": "string"}}},
    "manifest": {"type": "object", "required": ["version", "suite", "catalogs", "settings", "templates", "jobs", "resources", "fingerprint"], "properties": {"version": {"const": 1}, "suite": {"$ref": "#/$defs/suite"}, "catalogs": {"type": "object"}, "settings": {"$ref": "#/$defs/settings"}, "templates": {"type": "object"}, "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}}, "resources": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "import_attempt": {"type": "object", "required": ["job_id", "response", "completion_status", "provenance"], "properties": {"job_id": {"type": "string"}, "response": {"type": "string"}, "completion_status": {"enum": ["complete", "truncated", "transport-error"]}, "provenance": {"type": "object"}, "telemetry": {"type": ["object", "null"]}}},
    "imports": {"type": "object", "required": ["version", "attempts"], "properties": {"version": {"const": 1}, "attempts": {"type": "array", "items": {"$ref": "#/$defs/import_attempt"}}}},
    "attempt": {"type": "object", "required": ["job_id", "response", "completion_status", "provenance", "classification", "fingerprint"], "properties": {"job_id": {"type": "string"}, "response": {"type": "string"}, "completion_status": {"enum": ["complete", "truncated", "transport-error", "malformed-output"]}, "provenance": {"type": "object"}, "telemetry": {"type": ["object", "null"]}, "classification": {"enum": ["valid", "transport-error", "truncated", "malformed-output", "invalid-output"]}, "fingerprint": {"type": "string"}, "request": {"type": "object"}, "raw_response": {"type": ["string", "null"]}, "elapsed_seconds": {"type": "number"}, "error": {"type": ["string", "null"]}}},
    "attempts": {"type": "object", "required": ["version", "attempts"], "properties": {"version": {"const": 1}, "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}}},
    "evidence": {"type": "object", "required": ["source", "start", "end", "quote"], "properties": {"source": {"const": "response"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1}}},
    "assertion_result": {"type": "object", "required": ["id", "text", "verdict", "evidence"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "verdict": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "grade": {"type": "object", "required": ["job_id", "case_id", "fingerprint", "response_sha256", "assertion_results"], "properties": {"job_id": {"type": "string"}, "case_id": {"type": "string"}, "fingerprint": {"type": "string"}, "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "assertion_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion_result"}}}},
    "grading": {"type": "object", "required": ["version", "grades"], "properties": {"version": {"const": 1}, "grades": {"type": "array", "items": {"$ref": "#/$defs/grade"}}}},
    "findings": {"type": "object", "required": ["version", "findings_addressed"], "properties": {"version": {"const": 1}, "findings_addressed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
